# Entity: username_generation

main: kit: entity: username_generation: {

  alias: field: {}

  fields: [
    {
      name: "suggestions"
      req: false
      short: "Alternative username suggestions"
      type: "`$ARRAY`"
    }
    {
      name: "username"
      req: false
      short: "The generated username"
      type: "`$STRING`"
    }
    {
      name: "username_idea"
      req: true
      short: "The base idea or keyword for generating a username"
      type: "`$STRING`"
    }
  ]

  name: "username_generation"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/username_generate"
          segments: [
            {
              lit: "username_generate"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
